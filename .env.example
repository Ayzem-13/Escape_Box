# =============================================================================
# Escape_Box — Variables d'environnement
# =============================================================================
# Copie ce fichier en .env (valeurs publiques par défaut, committé)
# ou en .env.local (overrides locaux + secrets, jamais committé).
#
# Convention Vite :
#   - Toute variable doit commencer par VITE_ pour être exposée au client.
#   - Les variables sans préfixe VITE_ ne sont accessibles QUE côté Node
#     (scripts, vite.config.ts, playwright.config.ts).
# =============================================================================

# --- Application ---
VITE_APP_NAME="Escape Box"
VITE_APP_ENV=development

# --- Backend / API ---
VITE_API_URL=http://localhost:3000

# --- Dev server (lu par vite + playwright) ---
PORT=5173

# --- Playwright ---
# Surcharge l'URL de base (par défaut: http://localhost:${PORT})
# E2E_BASE_URL=http://localhost:5173

# =============================================================================
# Secrets (à mettre UNIQUEMENT dans .env.local — jamais committé)
# =============================================================================
# Exemples (décommente et remplis dans .env.local) :
# STRIPE_SECRET_KEY=
# DATABASE_URL=
# RESEND_API_KEY=
